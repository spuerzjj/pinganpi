{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["node", "vite/client"]
  },
  "include": [
    "apps/legacy-capacitor/src/**/*.ts",
    "apps/legacy-capacitor/src/**/*.vue",
    "apps/legacy-capacitor/vite.config.ts",
    "capacitor.config.ts",
    "services/**/*.ts",
    "packages/**/*.ts",
    "tools/scripts/**/*.ts",
    "vitest.config.ts"
  ]
}
