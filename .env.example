# Pinganpi AI proxy server env.
# Copy values into .env.ai.local or a shell environment.
# Do not commit real keys.
# The AI proxy scripts automatically read .env.ai.local.
# MIMO_API_BASE_URL and MIMO_MODEL_ID must come from the Xiaomi MiMo subscription page.

MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL_ID=mimo-v2.5-pro
MIMO_API_KEY=replace-with-secret-from-subscription-page
PINGANPI_AI_PROXY_PORT=8787
MIMO_REQUEST_TIMEOUT_MS=30000

# Local cost guards. Cloud console budgets and provider quota alerts are still required for production.
PINGANPI_AI_MAX_ORAL_TEXT_CHARS=800
MIMO_MAX_COMPLETION_TOKENS=900

# Optional for CloudBase env maintenance.
# enabled: configure all AI proxy env vars.
# disabled: remove MIMO_API_KEY from CloudBase env so the cloud proxy fails closed.
PINGANPI_CLOUDBASE_AI_ENV_MODE=enabled

# Optional CloudBase sync proxy for Stage 16B.
# Leave empty in local development to keep using the browser localStorage remote adapter.
VITE_PINGANPI_SYNC_PROXY_URL=
VITE_PINGANPI_SYNC_MEMBER_TOKEN=
PINGANPI_SYNC_SNAPSHOT_COLLECTION=pinganpi_sync_snapshots
PINGANPI_SYNC_MEMBER_TOKENS={"household-main":{"member-zhou":"replace-with-member-zhou-token","member-lan":"replace-with-member-lan-token"}}
