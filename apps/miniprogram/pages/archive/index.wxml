<view class="page-shell">
  <block wx:if="{{model}}">
    <view class="panel-stack">
      <view class="hero-panel">
        <view class="page-label">{{model.kicker}}</view>
        <view class="page-title">{{model.title}}</view>
        <view class="page-copy">旧信、邮政记录和往来线索在此归档。</view>
      </view>

      <view class="section-panel">
        <view class="section-title">旧信卷宗</view>
        <view class="record-list" wx:if="{{model.letters.length}}">
          <view class="record-row" wx:for="{{model.letters}}" wx:key="id">
            <view class="record-title">{{item.subject}}</view>
            <view class="record-meta">{{item.metaText}}</view>
            <view class="record-copy">{{item.excerpt}}</view>
            <view class="record-list">
              <view class="record-row" wx:for="{{item.records}}" wx:for-item="record" wx:key="*this">
                <view class="record-meta">{{record}}</view>
              </view>
            </view>
          </view>
        </view>
        <view class="empty-note" wx:else>旧信档案暂空。</view>
      </view>
    </view>
  </block>
</view>
