<view class="page-shell">
  <block wx:if="{{model}}">
    <view class="panel-stack">
      <view class="hero-panel">
        <view class="page-label">{{model.kicker}}</view>
        <view class="page-title">{{model.title}}</view>
        <view class="page-copy">{{model.cityText}}</view>
      </view>

      <view class="section-panel">
        <view class="section-title">今日先生名册</view>
        <view class="record-list">
          <view class="record-row" wx:for="{{model.scribes}}" wx:key="id">
            <view class="record-head">
              <view class="record-main">
                <view class="record-title">{{item.name}}</view>
                <view class="record-meta">{{item.styleText}} · {{item.feeText}}</view>
              </view>
              <text class="status-pill status-{{item.statusTone}}">{{item.statusText}}</text>
            </view>
            <view class="record-copy">擅写：{{item.specialtiesText}}</view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
