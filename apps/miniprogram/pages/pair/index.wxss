.invite-code {
  margin-top: 22rpx;
  border: 1rpx solid rgba(49, 84, 63, 0.24);
  border-radius: var(--radius-md);
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 48rpx;
  font-weight: 650;
  line-height: 1.6;
  text-align: center;
  letter-spacing: 0;
  padding: 18rpx;
}

.error-panel {
  border-color: rgba(166, 74, 58, 0.28);
  background: #fffafa;
}
