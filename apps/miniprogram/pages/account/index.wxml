<view class="page-shell">
  <view class="panel-stack">
    <view class="hero-panel">
      <view class="page-label">{{kicker}}</view>
      <view class="page-title">{{title}}</view>
      <view class="page-copy">{{body}}</view>
      <view class="empty-note">{{statusText}}</view>
    </view>

    <view class="section-panel" wx:if="{{account}}">
      <view class="section-title">当前账号</view>
      <view class="record-list">
        <view class="record-row">
          <view class="meta-row">
            <text class="meta-label">关系</text>
            <text class="meta-value">{{binding ? '已建立' : '未建立'}}</text>
          </view>
        </view>
      </view>
      <button class="action-button primary" wx:if="{{binding}}" bindtap="goToday">进入今日</button>
      <button class="action-button primary" wx:else bindtap="goPair">去关系簿</button>
      <button class="action-button" bindtap="logoutLocal">清除本机登录态</button>
    </view>

    <view class="section-panel" wx:if="{{!account}}">
      <view class="section-title">微信登录</view>
      <view class="record-copy">使用微信授权登录，进入你的账号簿。</view>
      <button
        class="action-button primary"
        loading="{{loading}}"
        disabled="{{loading}}"
        bindtap="onWechatLogin"
      >
        微信登录
      </button>
    </view>

    <view class="section-panel error-panel" wx:if="{{errorText}}">
      <view class="section-title">未成</view>
      <view class="record-copy">{{errorText}}</view>
    </view>
  </view>
</view>
