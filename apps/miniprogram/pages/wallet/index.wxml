<view class="page-shell">
  <block wx:if="{{model}}">
    <view class="panel-stack">
      <view class="hero-panel">
        <view class="page-label">{{model.kicker}}</view>
        <view class="page-title">{{model.title}}</view>
        <view class="page-copy">匣中现余 <text class="strong-number">{{model.balanceText}}</text></view>
      </view>

      <view class="section-panel">
        <view class="section-title">收支定例</view>
        <view class="metric-grid">
          <view class="metric-card">
            <view class="metric-label">进项</view>
            <view class="metric-value">{{model.incomeText}}</view>
          </view>
          <view class="metric-card">
            <view class="metric-label">日用</view>
            <view class="metric-value">{{model.livingCostText}}</view>
          </view>
        </view>
      </view>

      <view class="section-panel">
        <view class="section-title">近日账目</view>
        <view class="record-list" wx:if="{{model.ledgerRows.length}}">
          <view class="record-row" wx:for="{{model.ledgerRows}}" wx:key="label">
            <view class="record-head">
              <view class="record-title record-main">{{item.label}}</view>
              <view class="strong-number amount-{{item.tone}}">{{item.amountText}}</view>
            </view>
          </view>
        </view>
        <view class="empty-note" wx:else>暂无新账。</view>
      </view>
    </view>
  </block>
</view>
