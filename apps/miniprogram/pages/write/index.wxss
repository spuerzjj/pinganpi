.step-track {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
}

.step-cell {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  background: var(--surface-raised);
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1.3;
  text-align: center;
}

.step-active {
  border-color: rgba(49, 84, 63, 0.3);
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 650;
}

.step-done {
  border-color: transparent;
  background: var(--surface-muted);
  color: var(--text-secondary);
}

.oral-input {
  min-height: 260rpx;
  margin-top: 22rpx;
  line-height: 1.7;
  padding: 22rpx;
}

.final-input {
  min-height: 360rpx;
  margin-top: 22rpx;
  line-height: 1.7;
  padding: 22rpx;
}

.draft-preview {
  margin-top: 22rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  background: var(--surface-raised);
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.8;
  padding: 26rpx;
  white-space: pre-wrap;
}

.nav-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.nav-row .action-button {
  margin-top: 0;
}

.warning-note {
  color: var(--danger);
}
