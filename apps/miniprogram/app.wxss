@import "./styles/tokens.wxss";

page {
  min-height: 100%;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB",
    "Microsoft YaHei", sans-serif;
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
  width: 100%;
  max-width: 560px;
  margin: 0 auto;
}

.archive-panel {
  border: 2rpx solid var(--line);
  background: var(--surface);
  padding: 28rpx;
}

.kicker {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.title {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.body-copy {
  margin-top: 20rpx;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.75;
}

.panel-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.section-panel {
  border: 2rpx solid var(--line);
  background: var(--surface);
  padding: 28rpx;
  box-sizing: border-box;
}

.section-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.meta-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.55;
}

.meta-row:first-of-type {
  border-top: 0;
}

.meta-label {
  flex: 0 0 auto;
  color: var(--muted);
}

.meta-value {
  flex: 1;
  color: var(--ink);
  text-align: right;
}

.stamp {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border: 2rpx solid var(--seal);
  color: var(--seal);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 0;
}

.record-list {
  margin-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.record-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.record-row:last-child {
  border-bottom: 0;
}

.record-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
}

.record-meta {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.record-copy {
  margin-top: 14rpx;
  color: var(--ink);
  font-size: 27rpx;
  line-height: 1.75;
}

.record-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.strong-number {
  color: var(--seal);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.status-present {
  border-color: #2f6b4f;
  color: #2f6b4f;
}

.status-absent {
  border-color: var(--muted);
  color: var(--muted);
}

.amount-credit {
  color: #2f6b4f;
}

.amount-debit {
  color: var(--seal);
}

.empty-note {
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.6;
}
