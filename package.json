{
  "name": "pinganpi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "ai-proxy:dev": "node --env-file-if-exists=.env.ai.local --import tsx server/ai-scribe-proxy/dev-server.ts",
    "ai-proxy:check": "node --env-file-if-exists=.env.ai.local --import tsx server/ai-scribe-proxy/check-mimo.ts",
    "cloudbase:build:ai": "node --import tsx scripts/build-cloudbase-ai-proxy.ts",
    "cloudbase:login": "cloudbase login",
    "cloudbase:configure:ai-env": "node --env-file-if-exists=.env.ai.local --import tsx scripts/configure-cloudbase-ai-env.ts",
    "cloudbase:disable:ai-env": "PINGANPI_CLOUDBASE_AI_ENV_MODE=disabled node --env-file-if-exists=.env.ai.local --import tsx scripts/configure-cloudbase-ai-env.ts",
    "cloudbase:deploy:ai": "npm run cloudbase:build:ai && cloudbase fn deploy ai-scribe-proxy --httpFn --force",
    "cloudbase:build:sync": "node --import tsx scripts/build-cloudbase-sync-proxy.ts",
    "cloudbase:configure:sync-env": "node --env-file-if-exists=.env.sync.local --import tsx scripts/configure-cloudbase-sync-env.ts",
    "cloudbase:smoke:sync": "node --env-file-if-exists=.env.sync.local --import tsx scripts/smoke-cloudbase-sync-proxy.ts",
    "cloudbase:audit:stage19": "node --import tsx scripts/audit-cloudbase-stage19.ts",
    "cloudbase:deploy:sync": "npm run cloudbase:build:sync && cloudbase fn deploy sync-proxy --httpFn --force",
    "cap:sync": "npm run build && npx cap sync",
    "typecheck": "vue-tsc --noEmit",
    "miniprogram:typecheck": "tsc -p tsconfig.miniprogram.json --noEmit",
    "miniprogram:check": "npm run miniprogram:typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@cloudbase/cli": "^3.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.15.21",
    "@vitejs/plugin-vue": "^6.0.7",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vite": "^7.3.3",
    "vitest": "^3.1.4",
    "vue-tsc": "^3.3.1"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.4",
    "@cloudbase/node-sdk": "^3.18.1",
    "@varlet/ui": "^3.17.0",
    "vue": "^3.5.34"
  },
  "overrides": {
    "axios": "^1.16.1",
    "js-cookie": "^3.0.7",
    "lodash": "^4.18.1",
    "lodash.set": "file:vendor/lodash-set",
    "lodash.unset": "file:vendor/lodash-unset",
    "uuid": "^13.0.2"
  }
}
