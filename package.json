{
  "name": "pinganpi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite apps/legacy-capacitor --config apps/legacy-capacitor/vite.config.ts --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build apps/legacy-capacitor --config apps/legacy-capacitor/vite.config.ts",
    "preview": "vite preview apps/legacy-capacitor --config apps/legacy-capacitor/vite.config.ts --host 0.0.0.0",
    "ai-proxy:dev": "node --env-file-if-exists=.env.ai.local --import tsx services/ai-scribe-proxy/dev-server.ts",
    "ai-proxy:check": "node --env-file-if-exists=.env.ai.local --import tsx services/ai-scribe-proxy/check-mimo.ts",
    "cloudbase:build:ai": "node --import tsx tools/scripts/build-cloudbase-ai-proxy.ts",
    "cloudbase:login": "cloudbase login",
    "cloudbase:configure:ai-env": "node --env-file-if-exists=.env.ai.local --import tsx tools/scripts/configure-cloudbase-ai-env.ts",
    "cloudbase:disable:ai-env": "PINGANPI_CLOUDBASE_AI_ENV_MODE=disabled node --env-file-if-exists=.env.ai.local --import tsx tools/scripts/configure-cloudbase-ai-env.ts",
    "cloudbase:deploy:ai": "npm run cloudbase:build:ai && cloudbase fn deploy ai-scribe-proxy --httpFn --force",
    "cloudbase:build:sync": "node --import tsx tools/scripts/build-cloudbase-sync-proxy.ts",
    "cloudbase:configure:sync-env": "node --env-file-if-exists=.env.sync.local --import tsx tools/scripts/configure-cloudbase-sync-env.ts",
    "cloudbase:smoke:sync": "node --env-file-if-exists=.env.sync.local --import tsx tools/scripts/smoke-cloudbase-sync-proxy.ts",
    "cloudbase:audit:stage19": "node --import tsx tools/scripts/audit-cloudbase-stage19.ts",
    "cloudbase:deploy:sync": "npm run cloudbase:build:sync && cloudbase fn deploy sync-proxy --httpFn --force",
    "cloudbase:build:miniprogram": "node --import tsx tools/scripts/build-cloudbase-miniprogram-functions.ts",
    "cloudbase:deploy:miniprogram": "npm run cloudbase:build:miniprogram && cloudbase fn deploy pinganpi-ai --force && cloudbase fn deploy pinganpi-sync --force && cloudbase fn deploy pinganpi-account --force && cloudbase fn deploy pinganpi-pair --force",
    "cloudbase:smoke:miniprogram": "node --env-file-if-exists=.env.ai.local --env-file-if-exists=.env.sync.local --import tsx tools/scripts/smoke-cloudbase-miniprogram-functions.ts",
    "cap:sync": "npm run build && npx cap sync",
    "cap:doctor": "npx cap doctor",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "typecheck": "vue-tsc --noEmit",
    "miniprogram:typecheck": "tsc -p tsconfig.miniprogram.json --noEmit",
    "miniprogram:sync-shared": "node --import tsx tools/scripts/sync-miniprogram-shared-domain.ts",
    "miniprogram:check-shared": "node --import tsx tools/scripts/sync-miniprogram-shared-domain.ts --check",
    "miniprogram:check": "npm run miniprogram:check-shared && npm run miniprogram:typecheck",
    "miniprogram:devtools:smoke": "node tools/scripts/miniprogram-devtools-automator.cjs smoke",
    "miniprogram:devtools:flow": "node tools/scripts/miniprogram-devtools-automator.cjs flow",
    "roadmap:dev": "vite tools/roadmap-viewer --config tools/roadmap-viewer/vite.config.ts --host 0.0.0.0",
    "roadmap:build": "vue-tsc -p tools/roadmap-viewer/tsconfig.json --noEmit && vite build tools/roadmap-viewer --config tools/roadmap-viewer/vite.config.ts",
    "roadmap:preview": "vite preview tools/roadmap-viewer --config tools/roadmap-viewer/vite.config.ts --host 0.0.0.0",
    "structure:audit": "node --import tsx tools/scripts/audit-project-structure.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@cloudbase/cli": "^3.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.15.21",
    "@vitejs/plugin-vue": "^6.0.7",
    "esbuild": "^0.25.12",
    "miniprogram-automator": "^0.12.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vite": "^7.3.3",
    "vitest": "^3.1.4",
    "vue-tsc": "^3.3.1"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.4",
    "@cloudbase/node-sdk": "^3.18.1",
    "@varlet/ui": "^3.17.0",
    "vue": "^3.5.34"
  },
  "overrides": {
    "axios": "^1.16.1",
    "js-cookie": "^3.0.7",
    "lodash": "^4.18.1",
    "lodash.set": "file:vendor/lodash-set",
    "lodash.unset": "file:vendor/lodash-unset",
    "uuid": "^13.0.2"
  }
}
