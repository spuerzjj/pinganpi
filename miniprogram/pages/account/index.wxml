<view class="page-shell">
  <view class="panel-stack">
    <view class="archive-panel">
      <view class="kicker">{{kicker}}</view>
      <view class="title">{{title}}</view>
      <view class="body-copy">{{body}}</view>
      <view class="empty-note">{{statusText}}</view>
    </view>

    <view class="section-panel" wx:if="{{account}}">
      <view class="section-title">当前账号</view>
      <view class="record-list">
        <view class="record-row">
          <view class="meta-row">
            <text class="meta-label">手机号</text>
            <text class="meta-value">{{account.phoneNumber}}</text>
          </view>
        </view>
        <view class="record-row">
          <view class="meta-row">
            <text class="meta-label">关系</text>
            <text class="meta-value">{{binding ? '已建立' : '未建立'}}</text>
          </view>
        </view>
      </view>
      <button class="ledger-button primary" wx:if="{{binding}}" bindtap="goToday">进入今日</button>
      <button class="ledger-button primary" wx:else bindtap="goPair">去关系簿</button>
      <button class="ledger-button" bindtap="logoutLocal">清除本机登录态</button>
    </view>

    <view class="section-panel">
      <view class="section-title">微信手机号</view>
      <view class="record-copy">由微信授权后，云函数换取完整手机号并写入账号档案。</view>
      <button
        class="ledger-button primary"
        loading="{{loading}}"
        disabled="{{loading}}"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
      >
        微信手机号登录
      </button>
    </view>

    <view class="section-panel">
      <view class="section-title">开发兜底入口</view>
      <view class="record-copy">仅用于开发调试；短信验证码真实兜底会在人工验证阶段补齐，云端未开启时会安全拒绝。</view>
      <input
        class="paper-input"
        type="number"
        maxlength="11"
        value="{{devPhoneNumber}}"
        placeholder="输入手机号"
        bindinput="onDevPhoneInput"
      />
      <button class="ledger-button" loading="{{loading}}" disabled="{{loading}}" bindtap="onDevLogin">
        使用兜底入口
      </button>
    </view>

    <view class="section-panel error-panel" wx:if="{{errorText}}">
      <view class="section-title">未成</view>
      <view class="record-copy">{{errorText}}</view>
    </view>
  </view>
</view>
